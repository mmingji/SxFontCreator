{
  "name": "sxfont-creator",
  "version": "0.1.0",
  "private": true,
  "description": "SxFontCreator 手写字体制作器：打印模板照着写、扫描回传，全自动切格提取手写字形并生成个人手写体字体（纯前端、零后端、离线可用）",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "pack": "npm run build && node scripts/pack-dist.mjs",
    "preview": "vite preview",
    "charset": "node scripts/build-charset.mjs",
    "charrank": "node scripts/build-char-rank.mjs",
    "font-subset": "node scripts/build-font-subset.mjs",
    "handwriting-subset": "node scripts/build-handwriting-subset.mjs",
    "guide": "node scripts/build-guide.mjs",
    "inspect:os2": "node scripts/inspect-font-os2.mjs"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "esm-potrace-wasm": "^0.5.1",
    "fonteditor-core": "^2.6.3",
    "jszip": "^3.10.2",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "pinia": "^2.3.1",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "puppeteer-core": "^25.10.0",
    "vite": "^6.0.7"
  }
}
