{
  "name": "sxfont-creator",
  "version": "0.1.0",
  "private": true,
  "description": "SxFontCreator 手写字体制作器：打印模板照着写、扫描回传，全自动切格提取手写字形并生成个人手写体字体（纯前端、零后端、离线可用）",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "charset": "node scripts/build-charset.mjs",
    "frequency": "node scripts/build-frequency.mjs",
    "font-subset": "node scripts/build-font-subset.mjs",
    "test:smoke": "node test/smoke-app.mjs",
    "test:charset": "node test/charset.mjs",
    "test:frequency": "node test/frequency.mjs",
    "test:selection": "node test/selection.mjs",
    "test:imageops": "node test/image-ops.mjs",
    "test:scan": "node test/scan-preprocess.mjs",
    "test:template": "node test/template-pdf.mjs",
    "test:font": "node test/font-format.mjs",
    "test:render": "node test/render-pdf.mjs",
    "test": "npm run test:charset && npm run test:frequency && npm run test:selection && npm run test:imageops && npm run test:scan && npm run test:template && npm run test:font && npm run test:render && npm run build && npm run test:smoke"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "pdf-lib": "^1.17.1",
    "pinia": "^2.3.1",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "fonteditor-core": "^2.6.3",
    "pdfjs-dist": "^6.3.289",
    "puppeteer-core": "^25.10.0",
    "vite": "^6.0.7"
  }
}
